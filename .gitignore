# Dependencies / toolchain (reinstalled via npm, never committed)
node_modules/

# Packaged app + generic build outputs (rebuilt via rebuild_app.py, shipped through Releases)
dist/
build/

# Python / C++ build artefacts (rebuilt via core/build_core.py)
__pycache__/
*.pyc
*.pyd
*.pdb
*.lib
*.obj
*.o
*.a

# Windows shortcut (regenerated by rebuild_app.py)
*.lnk

# Local-only runtime files
*.log
preview/last_effect.json

# Incoming dropbox for the agent (never pushed to GitHub)
incoming/
incoming-2d/

# Backups
*.bak

# Compiled runtime output (rebuilt via tsc, see carrots-runtime/README.md)
carrots-runtime/dist/
